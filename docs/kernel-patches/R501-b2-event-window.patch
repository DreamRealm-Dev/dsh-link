+/** Browser global a deployment may set before client plugins mount; absent means off. */
+const EVENT_WINDOW_LIMIT_GLOBAL = '__DSH_EVENT_WINDOW_LIMIT__'
+
+/** Programmatic override for same-process consumers and tests; null means "use the global". */
+let programmaticWindowLimit: EventWindowLimit | null = null
