+/**
+ * Optional live-tail event window (R501): trimming invariants, the in-flight guard added by
+ * R501-P2, default-off equivalence, and limit resolution precedence.
+ *
+ * The unit cases pin MutableSessionEventSource and the module-level resolver. The client cases
+ * drive a real Session through the assembled client so the guard is exercised where it lives:
+ * loadOlder()/loadThrough() in flight, a resync replacement during a page loader, and the
+ * default-off path that must stay byte-identical to stock upstream behavior.
+ */
+
+import { afterEach, beforeEach, describe, expect, it, onTestFinished, vi } from 'vitest'
+import { LlmAttemptId } from '@deepseek-ai/dsh-llm'
+import { SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session/types'
+import type { SessionId } from '@deepseek-ai/dsh-api-remotes/client'
+import type { RemoteMock } from '@deepseek-ai/dsh-remote-mock'
+import type { RemoteResult } from '@deepseek-ai/dsh-typert-protocol'
+import { createClientTest, webApp } from '@deepseek-ai/dsh-client-test-runtime/src/assembly/index.ts'
+import {
+  MutableSessionEventSource,
+  configureEventWindowLimit,
+  resolveEventWindowLimit,
+} from '../src/client/contract/events.ts'
+import type { SessionEventLikeEntry } from '../src/client/contract/events.ts'
+import type { Session } from '../src/client/sessions/session.ts'
+import type {
+  SessionAssistantStreamFrame, SessionEventsPage, SessionPageRequest,
+} from '../src/types.ts'
+import { ev, plainTurn } from './event-script.client.ts'
+import { sessionBench } from './remote/bench.client.ts'
+import { FOLLOW, PAGE, followScript, history, pageRule, pushEvent } from './remote/session.client.ts'
+
+/** A Session talks through the Gateway client; its dependency cone is the Typert registry and the Connection. */
+const API_ROSTER = webApp.closure(['@deepseek-ai/dsh-api-gateway'])
+const clientIt = createClientTest({ roster: API_ROSTER })
+const SID = 'fk-r508' as SessionId
+const GLOBAL_KEY = '__DSH_EVENT_WINDOW_LIMIT__'
+
+beforeEach(() => {
+  configureEventWindowLimit(null)
+  Reflect.deleteProperty(globalThis, GLOBAL_KEY)
+})
+
+afterEach(() => {
+  configureEventWindowLimit(null)
+  Reflect.deleteProperty(globalThis, GLOBAL_KEY)
+})
+
+/** Retained event seqs of the Session's current window. */
+function eventSeqs(session: Session): number[] {
+  return session.eventSource.getSnapshot().entries.map(entry => entry.event.seq)
+}
+
+/** Record every published window change kind for the rest of the current case. */
+function recordChangeKinds(session: Session): string[] {
+  const kinds: string[] = []
+  onTestFinished(session.eventSource.subscribe(() => {
+    kinds.push(session.eventSource.getSnapshot().change.kind)
+  }))
+  return kinds
+}
+
+/** One live user-message entry at seq, shaped like the Host's append frame. */
+function liveEntry(seq: number, body = 'live'): SessionEventLikeEntry {
+  return { type: 'event', event: ev.user(SessionSeq(seq), body) }
+}
+
+/** Append count synthetic entries starting at offset and return them. */
+function feed(source: MutableSessionEventSource, count: number, offset = 0): SessionEventLikeEntry[] {
+  const appended: SessionEventLikeEntry[] = []
+  for (let index = 0; index < count; index += 1) {
+    const entry = liveEntry(offset + index)
+    source.append(entry)
+    appended.push(entry)
+  }
+  return appended
+}
+
+/** Wait until the Session has issued one page request. */
+async function waitForPage(mock: RemoteMock): Promise<void> {
+  await vi.waitFor(() => { expect(mock.log.requests(PAGE)).toHaveLength(1) })
+}
+
+describe('MutableSessionEventSource.trimToTail', () => {
+  it('keeps the tail through one replace and reports dropped/firstSeq', () => {
+    const source = new MutableSessionEventSource()
+    const all = feed(source, 20)
+    expect(source.length).toBe(20)
+
+    const published: number[] = []
+    onTestFinished(source.subscribe(() => { published.push(source.getSnapshot().revision) }))
+    const revision = source.getSnapshot().revision
+
+    const trim = source.trimToTail(5)
+    expect(trim).toEqual({ dropped: 15, firstSeq: 15 })
+    expect(source.length).toBe(5)
+    expect(published).toEqual([revision + 1])
+
+    const snapshot = source.getSnapshot()
+    expect(snapshot.revision).toBe(revision + 1)
+    expect(snapshot.hasMore).toBe(true)
+    expect(snapshot.change.kind).toBe('replace')
+    const change = snapshot.change
+    if (change.kind !== 'replace') throw new Error('expected a replace change')
+    expect(change.entries).toHaveLength(5)
+    // One publish: the change carries exactly the retained tail, in order and by identity.
+    change.entries.forEach((entry, index) => { expect(entry).toBe(all[15 + index]) })
+    expect(snapshot.entries.map(entry => entry.event.seq)).toEqual([15, 16, 17, 18, 19])
+  })
+
+  it('is a no-op when nothing would be dropped or the count is not positive', () => {
+    const source = new MutableSessionEventSource()
+    feed(source, 5)
+    const published: number[] = []
+    onTestFinished(source.subscribe(() => { published.push(source.getSnapshot().revision) }))
+    const revision = source.getSnapshot().revision
+
+    expect(source.trimToTail(5)).toEqual({ dropped: 0, firstSeq: undefined })
+    expect(source.trimToTail(9)).toEqual({ dropped: 0, firstSeq: undefined })
+    expect(source.trimToTail(0)).toEqual({ dropped: 0, firstSeq: undefined })
+    expect(source.trimToTail(-1)).toEqual({ dropped: 0, firstSeq: undefined })
+    expect(published).toEqual([])
+    expect(source.getSnapshot().revision).toBe(revision)
+    expect(source.length).toBe(5)
+  })
+
+  it('keeps appends contiguous after a trim and reports the new front', () => {
+    const source = new MutableSessionEventSource()
+    feed(source, 20)
+    source.trimToTail(5)
+
+    const next = liveEntry(20)
+    source.append(next)
+    expect(source.getSnapshot().change.kind).toBe('append')
+    expect(source.length).toBe(6)
+
+    expect(source.trimToTail(3)).toEqual({ dropped: 3, firstSeq: 18 })
+    expect(source.length).toBe(3)
+    expect(source.getSnapshot().entries.map(entry => entry.event.seq)).toEqual([18, 19, 20])
+  })
+})
+
+describe('resolveEventWindowLimit', () => {
+  it('prefers the programmatic limit, then the browser global, then off', () => {
+    expect(resolveEventWindowLimit()).toBeNull()
+
+    ;(globalThis as Record<string, unknown>)[GLOBAL_KEY] = {
+      maxEvents: 100,
+      slackEvents: 10,
+      trimOpeningPage: false,
+    }
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 100, slackEvents: 10, trimOpeningPage: false })
+
+    configureEventWindowLimit({ maxEvents: 5, slackEvents: 0, trimOpeningPage: true })
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 5, slackEvents: 0, trimOpeningPage: true })
+
+    configureEventWindowLimit(null)
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 100, slackEvents: 10, trimOpeningPage: false })
+  })
+
+  it('normalizes defaults and resolves malformed values to off without throwing', () => {
+    const malformed: unknown[] = [
+      'limit',
+      42,
+      true,
+      {},
+      null,
+      { maxEvents: 0 },
+      { maxEvents: -1 },
+      { maxEvents: 5.5 },
+      { maxEvents: '8' },
+      { maxEvents: Number.NaN },
+      { maxEvents: 8, slackEvents: -1 },
+      { maxEvents: 8, slackEvents: 1.5 },
+      { maxEvents: 8, slackEvents: '1' },
+    ]
+    for (const value of malformed) {
+      ;(globalThis as Record<string, unknown>)[GLOBAL_KEY] = value
+      expect(() => resolveEventWindowLimit()).not.toThrow()
+      expect(resolveEventWindowLimit()).toBeNull()
+    }
+  })
+
+  it('defaults slackEvents to 0 and trimOpeningPage to true, and lets an invalid programmatic value fall back', () => {
+    ;(globalThis as Record<string, unknown>)[GLOBAL_KEY] = { maxEvents: 8 }
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 8, slackEvents: 0, trimOpeningPage: true })
+
+    ;(globalThis as Record<string, unknown>)[GLOBAL_KEY] = { maxEvents: 8, slackEvents: 2 }
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 8, slackEvents: 2, trimOpeningPage: true })
+
+    ;(globalThis as Record<string, unknown>)[GLOBAL_KEY] = { maxEvents: 8, slackEvents: 2, trimOpeningPage: false }
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 8, slackEvents: 2, trimOpeningPage: false })
+
+    configureEventWindowLimit({ maxEvents: 0, slackEvents: 0, trimOpeningPage: true })
+    expect(resolveEventWindowLimit()).toEqual({ maxEvents: 8, slackEvents: 2, trimOpeningPage: false })
+  })
+})
