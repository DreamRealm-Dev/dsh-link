+describe('Session window: in-flight guard (R501-P2)', () => {
+  clientIt('does not trim while loadOlder is in flight, then resumes on the next live append', async ({ mock, start }) => {
+    configureEventWindowLimit({ maxEvents: 8, slackEvents: 0, trimOpeningPage: false })
+    const session = await sessionBench(mock, start, SID)
+    mock.stream(FOLLOW, followScript(history(plainTurn(SessionSeq(100), 0, 'q', 'a'), true)))
+    await session.open()
+    const kinds = recordChangeKinds(session)
+
+    const gate = Promise.withResolvers<RemoteResult<SessionEventsPage>>()
+    const pageRequests: SessionPageRequest[] = []
+    mock.remote.session.page.mockImplementation(pageRule((request) => {
+      pageRequests.push(request)
+      return gate.promise
+    }))
+    const older = session.loadOlder()
+    await waitForPage(mock)
+    expect(session.getSnapshot().loadingOlder).toBe(true)
+
+    // Length 10 > maxEvents 8 would trim in the settled state; the in-flight loader suppresses it.
+    for (const seq of [106, 107, 108, 109]) await pushEvent(mock, ev.user(SessionSeq(seq), 'live-' + String(seq)))
+    expect(eventSeqs(session)).toEqual([100, 101, 102, 103, 104, 105, 106, 107, 108, 109])
+    expect(kinds).toEqual(['append', 'append', 'append', 'append'])
+
+    gate.resolve(history([], false))
+    await older
+    expect(session.getSnapshot().loadingOlder).toBe(false)
+
+    await pushEvent(mock, ev.user(SessionSeq(110), 'live-110'))
+    expect(kinds.at(-1)).toBe('replace')
+    expect(eventSeqs(session)).toEqual([103, 104, 105, 106, 107, 108, 109, 110])
+
+    // baseSeq moved with the retained front: loadOlder pages from seq 103 now.
+    await session.loadOlder()
+    expect(pageRequests.at(-1)?.beforeSeq).toBe(103)
+  })
+
+  clientIt('does not trim while a turn jump is in flight (pendingHistory), then resumes on settle', async ({ mock, start }) => {
