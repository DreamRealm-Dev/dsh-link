@@ -0,0 +1,319 @@
+/**
+ * Multi-level Agent Teams regression coverage (R484/R490).
+ *
+ * The default suite only reaches the Lead's direct children. These cases exercise the
+ * nesting paths that were measured LIVE and had no automated coverage: roster
+ * depth/spawnedBy metadata, nested spawn parent identity, depth admission, the
+ * interrupt-scope matrix, and the model-facing tool-output contract that turned a
+ * successful multi-level spawn into INVALID_TOOL_OUTPUT. The composition mirrors
+ * `team.spec.ts`: real Cordis plugins with the mock LLM adapter.
+ */
+
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { mkdtempSync, rmSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import { ToolCallId } from '@deepseek-ai/dsh-llm'
+import { SessionId } from '@deepseek-ai/dsh-session'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import SubagentService from '@deepseek-ai/dsh-subagent'
+import * as SubagentFork from '@deepseek-ai/dsh-subagent-fork-in-process'
+import * as SubagentSpawn from '@deepseek-ai/dsh-subagent-spawn-in-process'
+import { MockAdapter } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { mountWorkingDirectoryFixture } from '../../../subagent/subagent/tests/working-directory-fixture.ts'
+import * as toolTeam from '../../tool-agent-team/src/index.ts'
+import TeamService from '../src/index.ts'
+import type { Config, TeamMemberSnapshot, TeamMemberView } from '../src/index.ts'
+import { teamProjectionDefinition } from '../src/projection.ts'
+import { TestSessionQuery } from './test-session-query.ts'
+
+const SIGNAL = new AbortController().signal
+const roots: string[] = []
+const contexts: Context[] = []
+
+/** Deployment that admits Lead -> teammate -> teammate's teammate and ancestor interruption. */
+const NESTED: Config = { maxDepth: 3, teammatesMaySpawn: true, interruptScope: 'descendants' }
+
+afterEach(async () => {
+  vi.restoreAllMocks()
+  for (const ctx of contexts.splice(0).reverse()) await ctx.fiber.dispose()
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+})
+
+async function setup(
+  script: ConstructorParameters<typeof MockAdapter>[0],
+  config: Config = {},
+  options: { readonly tools?: boolean } = {},
+) {
+  const ctx = new Context()
+  contexts.push(ctx)
+  await mountAgentLoopTestDependencies(ctx)
+  await mountWorkingDirectoryFixture(ctx)
+  const storageRoot = mkdtempSync(join(tmpdir(), 'dsh-team-multilevel-'))
+  roots.push(storageRoot)
+  await ctx.plugin(JsonlSessionPersistence, { root: storageRoot })
+  await ctx.plugin(TestSessionQuery)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(SubagentService)
+  await ctx.plugin(SubagentSpawn, { providerName: 'spawn' })
+  await ctx.plugin(SubagentFork, { providerName: 'fork' })
+  await ctx.plugin(TeamService, config)
+  if (options.tools === true) await ctx.plugin(toolTeam)
+  const adapter = new MockAdapter(script)
+  ctx.llm.registerAdapter(['mock'], adapter)
+  const lead = await ctx.agentLoop.create(SessionId('lead'), { provider: 'mock', model: 'mock' })
+  return { ctx, lead, adapter }
+}
+
+function content(text: string) {
+  return [{ type: 'text' as const, text }]
+}
+
+/** Request one teammate creation as the exact live caller. */
+function spawn(ctx: Context, caller: Agent, name: string) {
+  return ctx.agentTeams.spawnTeammate(caller, {
+    name,
+    description: `${name} responsibility`,
+    prompt: content(`${name} initial`),
+    context: 'fresh',
+    provider: 'spawn',
+    signal: SIGNAL,
+  })
+}
+
+/** Fold the Lead's durable Session log through the shipped Team projection. */
+function durableMembers(agent: Agent): readonly TeamMemberSnapshot[] {
+  let projected = teamProjectionDefinition.init(agent.session.header)
+  for (const event of agent.session.snapshotEvents()) projected = teamProjectionDefinition.apply(projected, event)
+  if (projected.failure !== undefined) throw new Error(projected.failure)
+  return projected.members
+}
+
+/** Resolve one runtime roster row by name, failing loudly when absent. */
+function rosterMember(ctx: Context, caller: Agent, name: string): TeamMemberView {
+  const row = ctx.agentTeams.listMembers(caller).find(candidate => candidate.name === name)
+  if (row === undefined) throw new Error(`Team roster has no member "${name}"`)
+  return row
+}
+
+/** Observe each subagent activation request while keeping the real provider behavior. */
+function captureStartActivations(ctx: Context): Array<{ readonly parent: Agent }> {
+  const started: Array<{ readonly parent: Agent }> = []
+  const start = ctx.subagents.startActivation.bind(ctx.subagents)
+  vi.spyOn(ctx.subagents, 'startActivation').mockImplementation(async (spec) => {
+    started.push({ parent: spec.request.parent })
+    return start(spec)
+  })
+  return started
+}
+
+async function waitRunning(ctx: Context, id: SessionId): Promise<Agent> {
+  return vi.waitFor(() => {
+    const agent = ctx.agents.get(id)
+    expect(agent?.status).toBe('running')
+    return agent!
+  }, { timeout: 5_000 })
+}
+
+let callNumber = 0
+
+/** Execute one scoped Team tool as an exact live member, through the batch executor. */
+async function execute(ctx: Context, agent: Agent, name: string, args: unknown) {
+  const batch = await ctx.tools.execute({
+    calls: [{ type: 'tool-call', id: ToolCallId(`multilevel-call-${++callNumber}`), name, arguments: JSON.stringify(args) }],
+    signal: SIGNAL,
+    agent,
+  })
+  const outcome = batch.results[0]
+  if (outcome === undefined) throw new Error('tool batch omitted the result')
+  return outcome.result
+}
+
+function text(result: Awaited<ReturnType<typeof execute>>): string {
+  return result.content.flatMap(block => block.type === 'text' ? [block.text] : []).join('')
+}
+
+describe('multi-level Agent Teams', () => {
+  it('records a Lead-created teammate as depth 1 and spawnedBy "lead" once nesting is admitted', async () => {
+    const { ctx, lead } = await setup(['hang'], NESTED)
+    const starts = captureStartActivations(ctx)
+
+    const started = await spawn(ctx, lead, 'l2-worker')
+    await waitRunning(ctx, started.member.id)
+
+    expect(starts).toHaveLength(1)
+    expect(starts[0]?.parent).toBe(lead)
+    expect(started.member).toMatchObject({
+      name: 'l2-worker',
+      role: 'teammate',
+      depth: 1,
+      spawnedBy: 'lead',
+    })
+    expect(durableMembers(lead)[0]).toMatchObject({
+      name: 'l2-worker',
+      phase: 'active',
+      depth: 1,
+      spawnedBy: 'lead',
+    })
+    const rows = ctx.agentTeams.listMembers(lead)
+    expect(rows.map(row => [row.name, row.role, row.depth, row.spawnedBy])).toEqual([
+      ['lead', 'lead', 0, undefined],
+      ['l2-worker', 'teammate', 1, 'lead'],
+    ])
+    expect(rows[0]).not.toHaveProperty('spawnedBy')
+    const membership = ctx.agentTeams.membership(ctx.agents.get(started.member.id)!)
+    expect(membership.root).toBe(lead)
+    expect(membership).toMatchObject({ name: 'l2-worker', role: 'teammate', depth: 1, spawnedBy: 'lead' })
+  })
+
+  it('spawns a nested teammate under its creator and lets that ancestor interrupt it', async () => {
+    const { ctx, lead } = await setup(['hang', 'hang'], NESTED)
+    const starts = captureStartActivations(ctx)
+
+    const outer = await spawn(ctx, lead, 'builder')
+    const builder = await waitRunning(ctx, outer.member.id)
+    const inner = await spawn(ctx, builder, 'probe')
+    const probe = await waitRunning(ctx, inner.member.id)
+
+    expect(starts).toHaveLength(2)
+    expect(starts[0]?.parent).toBe(lead)
+    expect(starts[1]?.parent).toBe(builder)
+    expect(inner.member).toMatchObject({ name: 'probe', role: 'teammate', depth: 2, spawnedBy: 'builder' })
+    expect(durableMembers(lead).find(member => member.name === 'probe')).toMatchObject({
+      phase: 'active',
+      depth: 2,
+      spawnedBy: 'builder',
+    })
+    const membership = ctx.agentTeams.membership(probe)
+    expect(membership.root).toBe(lead)
+    expect(membership).toMatchObject({ name: 'probe', role: 'teammate', depth: 2, spawnedBy: 'builder' })
+    expect(ctx.agentTeams.listMembers(builder).map(row => [row.name, row.depth, row.spawnedBy])).toEqual([
+      ['lead', 0, undefined],
+      ['builder', 1, 'lead'],
+      ['probe', 2, 'builder'],
+    ])
+
+    expect(ctx.agentTeams.interrupt(builder, 'probe')).toEqual({ previousStatus: 'running' })
+    await probe.whenIdle()
+    expect(ctx.agentTeams.interrupt(lead, 'probe')).toEqual({ previousStatus: 'inactive' })
+  })
+
+  it('admits a depth-2 child at maxDepth 2 and refuses the next generation with TEAM_DEPTH_LIMIT', async () => {
+    const { ctx, lead } = await setup(['hang', 'hang'], { maxDepth: 2, teammatesMaySpawn: true })
+    const outer = await spawn(ctx, lead, 'builder')
+    const builder = await waitRunning(ctx, outer.member.id)
+    const inner = await spawn(ctx, builder, 'probe')
+    const probe = await waitRunning(ctx, inner.member.id)
+    expect(inner.member).toMatchObject({ depth: 2, spawnedBy: 'builder' })
+
+    await expect(spawn(ctx, probe, 'too-deep')).rejects.toMatchObject({ code: 'TEAM_DEPTH_LIMIT' })
+    expect(durableMembers(lead).map(member => member.name)).toEqual(['builder', 'probe'])
+  })
+
+  it('refuses the first teammate-created child when maxDepth stays at 1', async () => {
+    const { ctx, lead } = await setup(['hang'], { maxDepth: 1, teammatesMaySpawn: true })
+    const outer = await spawn(ctx, lead, 'builder')
+    const builder = await waitRunning(ctx, outer.member.id)
+
+    await expect(spawn(ctx, builder, 'probe')).rejects.toMatchObject({ code: 'TEAM_DEPTH_LIMIT' })
+    expect(durableMembers(lead).map(member => member.name)).toEqual(['builder'])
+  })
+
+  it('keeps the upstream single-level shape and Lead-only creation under default configuration', async () => {
+    const { ctx, lead } = await setup(['hang'])
+    expect(ctx.agentTeams.policy()).toEqual({ maxDepth: 1, teammatesMaySpawn: false, interruptScope: 'none' })
+
+    const started = await spawn(ctx, lead, 'worker')
+    await waitRunning(ctx, started.member.id)
+
+    const snapshot = durableMembers(lead)[0]!
+    expect(Object.keys(snapshot).sort()).toEqual(['context', 'description', 'id', 'name', 'phase', 'provider'])
+    expect(snapshot).not.toHaveProperty('depth')
+    expect(snapshot).not.toHaveProperty('spawnedBy')
+    expect(started.member).not.toHaveProperty('depth')
+    expect(started.member).not.toHaveProperty('spawnedBy')
+    const rows = ctx.agentTeams.listMembers(lead)
+    expect(rows[0]).not.toHaveProperty('depth')
+    expect(rows[1]).not.toHaveProperty('depth')
+    expect(rows[1]).not.toHaveProperty('spawnedBy')
+
+    const worker = ctx.agents.get(started.member.id)!
+    await expect(spawn(ctx, worker, 'nested')).rejects.toMatchObject({ code: 'TEAM_LEAD_REQUIRED' })
+  })
+
+  it('keeps interruption Lead-only under the default interruptScope', async () => {
+    const { ctx, lead } = await setup(['hang', 'hang'])
+    const first = await spawn(ctx, lead, 'first')
+    const firstAgent = await waitRunning(ctx, first.member.id)
+    const second = await spawn(ctx, lead, 'second')
+    await waitRunning(ctx, second.member.id)
+
+    expect(() => ctx.agentTeams.interrupt(firstAgent, 'second'))
+      .toThrow(expect.objectContaining({ code: 'TEAM_LEAD_REQUIRED' }))
+    expect(ctx.agentTeams.interrupt(lead, 'second')).toEqual({ previousStatus: 'running' })
+    expect(() => ctx.agentTeams.interrupt(lead, 'lead'))
+      .toThrow(expect.objectContaining({ code: 'TEAM_INVALID_TARGET' }))
+  })
+
+  it('admits descendant interruption and rejects sibling targets when interruptScope is descendants', async () => {
+    const { ctx, lead } = await setup(['hang', 'hang', 'hang'], NESTED)
+    const leftSpawn = await spawn(ctx, lead, 'left')
+    const left = await waitRunning(ctx, leftSpawn.member.id)
+    const rightSpawn = await spawn(ctx, lead, 'right')
+    const right = await waitRunning(ctx, rightSpawn.member.id)
+    const probeSpawn = await spawn(ctx, left, 'left-probe')
+    await waitRunning(ctx, probeSpawn.member.id)
+
+    expect(() => ctx.agentTeams.interrupt(right, 'left-probe'))
+      .toThrow(expect.objectContaining({ code: 'TEAM_INTERRUPT_FORBIDDEN' }))
+    expect(() => ctx.agentTeams.interrupt(left, 'right'))
+      .toThrow(expect.objectContaining({ code: 'TEAM_INTERRUPT_FORBIDDEN' }))
+    expect(ctx.agentTeams.interrupt(left, 'left-probe')).toEqual({ previousStatus: 'running' })
+    expect(ctx.agentTeams.interrupt(lead, 'right')).toEqual({ previousStatus: 'running' })
+  })
+
+  it('keeps nested spawn_teammate and list_agents values inside the declared tool-output schema', async () => {
+    const { ctx, lead } = await setup(['hang', 'hang'], NESTED, { tools: true })
+
+    const leadSpawn = await execute(ctx, lead, 'spawn_teammate', {
+      name: 'builder',
+      description: 'builder responsibility',
+      prompt: 'build',
+    })
+    expect(leadSpawn.isError, text(leadSpawn)).toBe(false)
+    const builder = await waitRunning(ctx, rosterMember(ctx, lead, 'builder').id)
+    expect(JSON.parse(text(leadSpawn))).toMatchObject({
+      member: { target: 'builder', depth: 1, spawnedBy: 'lead' },
+    })
+
+    // The P1 regression: a multi-level spawn value that the output schema did not declare
+    // failed validation with INVALID_TOOL_OUTPUT even though the spawn itself succeeded.
+    const nestedSpawn = await execute(ctx, builder, 'spawn_teammate', {
+      name: 'probe',
+      description: 'probe responsibility',
+      prompt: 'probe',
+    })
+    expect(nestedSpawn.isError, text(nestedSpawn)).toBe(false)
+    expect(JSON.parse(text(nestedSpawn))).toMatchObject({
+      member: { target: 'probe', depth: 2, spawnedBy: 'builder' },
+    })
+    await waitRunning(ctx, rosterMember(ctx, lead, 'probe').id)
+
+    const listed = await execute(ctx, builder, 'list_agents', {})
+    expect(listed.isError, text(listed)).toBe(false)
+    const rows = JSON.parse(text(listed)) as Array<{
+      target: string
+      depth?: number
+      spawnedBy?: string
+    }>
+    expect(rows.map(row => [row.target, row.depth, row.spawnedBy])).toEqual([
+      ['lead', 0, undefined],
+      ['builder', 1, 'lead'],
+      ['probe', 2, 'builder'],
+    ])
+  })
+})
