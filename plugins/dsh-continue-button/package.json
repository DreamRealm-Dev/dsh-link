{
  "name": "dsh-continue-button",
  "version": "0.1.0",
  "requires": { "dsh": "^0.2.0" },
  "private": true,
  "description": "聊天界面的「继续生成」按钮：在最后一条助手消息的操作行里追加一个入口，会话空闲时显示，点击即以官方提交路径发送一条「继续」——对冲流内护栏误掐与上游截断。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
