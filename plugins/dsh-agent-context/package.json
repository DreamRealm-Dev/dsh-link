{
  "name": "dsh-agent-context",
  "version": "0.1.0",
  "requires": { "dsh": "^0.2.0" },
  "private": true,
  "description": "Let a DeepSeek Harness Lead measure and compact the context of the teammates and subagents it delegated to — agent_context (status) and compact_agent (compact one delegate in place).",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./current": {
      "default": "./lib/current.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  }
}
