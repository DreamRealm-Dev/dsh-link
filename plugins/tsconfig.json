{
  // Strict TypeScript gate for the DSH-LINK plugins (R488).
  //
  // Run it with `node scripts/typecheck-plugins.mjs`. The program roots are the
  // plugin sources; kernel packages arrive as the kernel's own declaration files
  // (each kernel package's `exports.types`, built by `pnpm run build:artifacts`),
  // which is the same view a published consumer gets. Declaration files are not
  // re-checked (skipLibCheck); their internal imports resolve through the kernel's
  // own installed node_modules links, so the kernel checkout stays the single
  // source of types and this directory stays outside the pnpm workspace.
  //
  // The compiler flags are the kernel tsconfig.base.json strict face, spelled out
  // rather than inherited: `extends` would also import a repo-wide `paths` map
  // that resolves kernel packages to their sources, which drags kernel sources
  // into this program and checks them under flags their packages do not use
  // (vendor/* weaken several of them). scripts/typecheck-plugins.mjs verifies this
  // file's strict flags still equal the kernel's, so drift is a gate failure
  // rather than a silent divergence.
  //
  // Overrides, each with the reason it is not the kernel base value:
  //   jsx/lib                  browser halves are TSX and use DOM APIs; the kernel's
  //                            client face sets jsx: react-jsx and these libs.
  //   resolveJsonModule        dsh-link-responsive imports bands.json.
  //   noEmit/declaration/...   a typecheck gate never emits.
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable", "ESNext.Disposable"],
    "types": ["node"],
    "typeRoots": ["./../core/deepseek-harness/node_modules/@types"],
    "resolveJsonModule": true,
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@deepseek-ai/cordis": ["../core/deepseek-harness/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/schemastery": ["../core/deepseek-harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../core/deepseek-harness/packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-scope": ["../core/deepseek-harness/packages/core/scope/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-store": ["../core/deepseek-harness/packages/client/store/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-primitives": ["../core/deepseek-harness/packages/client/ui-primitives/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-slots": ["../core/deepseek-harness/packages/client/ui-slots/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings": ["../core/deepseek-harness/packages/client/ui-settings/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-settings/client": ["../core/deepseek-harness/packages/client/ui-settings/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-locale/client": ["../core/deepseek-harness/packages/client/locale/lib/types/client/index.d.ts"],
      "@deepseek-ai/dsh-client-ui-renderer/client": ["../core/deepseek-harness/packages/client/ui-renderer/lib/types/client/index.d.ts"],
      "react": ["../core/deepseek-harness/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": ["../core/deepseek-harness/node_modules/@types/react/jsx-runtime.d.ts"],
      "react/jsx-dev-runtime": ["../core/deepseek-harness/node_modules/@types/react/jsx-dev-runtime.d.ts"],
      "react-dom": ["../core/deepseek-harness/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["../core/deepseek-harness/node_modules/@types/react-dom/client.d.ts"]
    }
  },
  "include": [
    "*/src/**/*.ts",
    "*/src/**/*.tsx",
    "strict-modules.d.ts"
  ],
  "exclude": [
    "*/lib",
    "*/node_modules"
  ]
}
