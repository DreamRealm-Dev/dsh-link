{
  "name": "dsh-link-markdown",
  "version": "0.1.0",
  "requires": { "dsh": "^0.2.0" },
  "private": true,
  "description": "右栏的 Markdown 标签类型：渲染工作区里的 .md/.markdown 文件并可原地编辑保存（保存走 Host 半的一条窄路由，版本守卫用内核自己的 FsVersion），公式与代码高亮复用内核客户端已有的 KaTeX/Shiki，自己不带渲染依赖。",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
