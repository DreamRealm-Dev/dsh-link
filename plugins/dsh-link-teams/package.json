{
  "name": "dsh-link-teams",
  "version": "0.1.0",
  "requires": {
    "dsh": "^0.2.0"
  },
  "private": true,
  "description": "The collaboration bus made visible: a read-only right-rail pane that folds the control ledger into a team tree, a task board, member capabilities and liveness, and the stream of control records.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
