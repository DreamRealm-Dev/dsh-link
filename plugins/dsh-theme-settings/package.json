{
  "name": "dsh-theme-settings",
  "version": "0.1.0",
  "requires": { "dsh": "^0.2.0" },
  "private": true,
  "description": "The Theme section of the DeepSeek Harness settings panel: currently the control style (official / Liquid Glass).",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "dsh-liquid-glass"
      ]
    }
  }
}
