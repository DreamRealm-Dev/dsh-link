{
  "name": "dsh-liquid-glass",
  "version": "0.1.0",
  "requires": { "dsh": "^0.2.0" },
  "private": true,
  "description": "Apple Liquid Glass control material for the DeepSeek Harness web client (a control-design skin, not a UI rewrite).",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
